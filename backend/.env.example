PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://your-frontend-domain.example
NODE_ENV=production
# Optional: password reset emails via Resend (https://resend.com). Without these, managers can still create reset links.
RESEND_API_KEY=
EMAIL_FROM=HK SYNC <noreply@your-domain.example>
# Optional: frontend URL used in reset links (defaults to the first CLIENT_URL)
APP_URL=
